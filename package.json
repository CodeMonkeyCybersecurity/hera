{
  "name": "hera-chrome-extension",
  "version": "1.0.0",
  "description": "Hera - Security testing extension for authentication flows",
  "type": "module",
  "scripts": {
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js --fix",
    "lint:modules": "ESLINT_USE_FLAT_CONFIG=false eslint modules --ext .js",
    "lint:background": "ESLINT_USE_FLAT_CONFIG=false eslint background.js modules/background --ext .js",
    "lint:content": "ESLINT_USE_FLAT_CONFIG=false eslint content-script.js modules/content --ext .js",
    "lint:popup": "ESLINT_USE_FLAT_CONFIG=false eslint popup.js modules/ui --ext .js",
    "lint:watch": "nodemon --watch . --ext js --exec 'npm run lint'",
    "validate": "node scripts/validate-extension.js",
    "check": "npm run lint && npm run validate",
    "preload": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "npm run check && npm run test:coverage",
    "ci": "ESLINT_USE_FLAT_CONFIG=false eslint modules/auth/auth-issue-database.js modules/auth/oauth2-analyzer.js modules/auth/auth-util-functions.js modules/auth/jwt-validator.js modules/auth/oidc-validator.js tests/unit/auth-issue-database.test.js && npm run validate && npm run test:coverage",
    "prepare": "husky"
  },
  "keywords": [
    "chrome-extension",
    "security",
    "oauth",
    "authentication",
    "security-testing"
  ],
  "author": "Code Monkey Cybersecurity",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "ae-cvss-calculator": "^1.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.7",
    "@vitest/ui": "^4.0.7",
    "eslint": "^8.57.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.6",
    "nodemon": "^3.0.2",
    "vitest": "^4.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.js": [
      "env ESLINT_USE_FLAT_CONFIG=false eslint --fix",
      "vitest related --run"
    ]
  }
}
